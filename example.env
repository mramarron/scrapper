#this is an example .env file. Copy this file to .env and fill in the values for your database connection.
# Primary database settings. Supported DB_ENGINE values: postgresql (default) or mssql.
DB_ENGINE=postgresql
DB_HOST=your_db_host
# PostgreSQL default port: 5432.
DB_PORT=your_db_port
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Optional secondary SQL Server connection. Install the Microsoft ODBC driver.
# Use SessionLocal for the primary database and MSSQLSessionLocal for SQL Server.
MSSQL_DB_HOST=your_sql_server_host
MSSQL_DB_PORT=1433
MSSQL_DB_NAME=your_sql_server_database
MSSQL_DB_USER=your_sql_server_user
MSSQL_DB_PASSWORD=your_sql_server_password
# Defaults to ODBC Driver 18 for SQL Server.
# MSSQL_DB_DRIVER=ODBC Driver 18 for SQL Server
# Alternatively, provide a complete SQLAlchemy URL instead of MSSQL_DB_*:
# MSSQL_DATABASE_URL=mssql+pyodbc://user:password@host:1433/database?driver=ODBC+Driver+18+for+SQL+Server